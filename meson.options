option(
'with_wayland',
type: 'boolean',
value: true,
description: 'Allows Wayland to use Vulkan, however prevents X11 from using Vulkan'
)

option(
'build_tools',
type: 'boolean',
value: true,
description: 'Builds the bgfx toolkit'
)

option(
'shaderc-glslang',
type: 'boolean',
value: true,
description: 'Compiles with glslang'
)

option(
'shaderc-tint',
type: 'boolean',
value: true,
description: 'Compiles with tint'
)

option(
'shaderc-d3d',
type: 'boolean',
value: false,
description: 'Compiles with d3d'
)
